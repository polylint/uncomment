#!/usr/bin/env node
// Launcher stub. The native executable comes from the matching platform package
// (an optionalDependency), or, when none was installed, from the binary the
// postinstall download fallback placed beside this file. Keeping the npm `bin`
// entry a script means the published tarball stays platform-neutral and npm can
// generate its Windows .cmd shim.
const { spawnSync } = require("node:child_process");
const { missingBinaryMessage, resolveBinaryPath } = require("../index.js");

const executable = resolveBinaryPath();

if (executable === null) {
  console.error(missingBinaryMessage());
  process.exit(1);
}

const result = spawnSync(executable, process.argv.slice(2), {
  stdio: "inherit",
});

if (result.error) {
  console.error(`uncomment: could not run ${executable}: ${result.error.message}`);
  process.exit(1);
}

// A child killed by a signal reports status null; surface that as a failure
// rather than exiting 0.
process.exit(result.status === null ? 1 : result.status);
